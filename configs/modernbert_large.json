{
  "base_model": "answerdotai/ModernBERT-large",
  "train_path": "data/train.jsonl",
  "eval_path": "data/eval.jsonl",
  "calibration_path": "data/calibration.jsonl",
  "output_dir": "checkpoints/openjev-large",
  "max_length": 2048,
  "batch_size": 4,
  "grad_accum": 8,
  "epochs": 2,
  "lr": 2e-5,
  "head_lr": 1e-4,
  "warmup_ratio": 0.06,
  "gradient_checkpointing": true,
  "bf16": true,
  "eval_every": 500
}
