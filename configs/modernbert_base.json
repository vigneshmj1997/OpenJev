{
  "base_model": "answerdotai/ModernBERT-base",
  "train_path": "data/train.jsonl",
  "eval_path": "data/eval.jsonl",
  "calibration_path": "data/calibration.jsonl",
  "output_dir": "checkpoints/openjev-base",
  "max_length": 1024,
  "batch_size": 8,
  "grad_accum": 4,
  "epochs": 3,
  "lr": 3e-5,
  "head_lr": 1e-4,
  "gradient_checkpointing": false,
  "bf16": true,
  "eval_every": 250
}
